{
  "name": "v2ex-tui",
  "version": "1.0.0",
  "description": "V2EX 终端客户端 (TUI)",
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --no-minify",
    "watch": "node scripts/build.mjs --watch --no-minify",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "start": "node dist/v2ex.js"
  },
  "keywords": [
    "v2ex",
    "tui",
    "cli",
    "terminal"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "ink": "^3.2.0",
    "react": "^17.0.2",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "^17.0.93",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "bin": {
    "v2ex": "dist/v2ex.js"
  },
  "engines": {
    "node": ">=18"
  }
}
